{
  "name": "@nexumia-de/materia",
  "version": "0.3.0",
  "private": true,
  "description": "The general model shared by Mixtura and Culina: ingredient tree, templates with slots, versioned specs, stock and shelf life; pure functions",
  "license": "AGPL-3.0-or-later",
  "repository": "github:nexumia-de/materia",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/materia.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node build.mjs",
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
