        }
      },
      "expected": {
        "ok": true,
        "unit": {
          "format": "materia-unit",
          "version": 1,
          "kind": "library",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {
            "specs": [
              {
                "key": "",
                "updatedAt": "bad"
              }
            ]
          }
        }
      }
    },
    {
      "name": "not json",
      "input": {
        "text": "nope"
      },
      "expected": {
        "ok": false,
        "error": "not-json"
      }
    },
    {
      "name": "an array is not a unit",
      "input": {
