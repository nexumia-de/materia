{
  "id": "unit-parse",
  "kind": "unit-parse",
  "description": "parseUnit. Valid documents of each kind; unknown top-level fields are ignored; unknown collections are kept. Errors: not-json; not-a-unit (not an object, other format); newer-version (checked before the rest); unknown-kind (a kind string other than place, library, profile); invalid (version not 1, missing kind, broken unit, collections not an object, bad collection name, collection not an array of objects, broken moved).",
  "source": "docs/sync.md",
  "cases": [
    {
      "name": "place without collections",
      "input": {
        "json": {
          "format": "materia-unit",
          "version": 1,
          "kind": "place",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {}
        }
      },
      "expected": {
        "ok": true,
        "unit": {
          "format": "materia-unit",
          "version": 1,
          "kind": "place",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {}
        }
      }
    },
    {
      "name": "profile with two collections and moved with note",
      "input": {
        "json": {
          "format": "materia-unit",
          "version": 1,
          "kind": "profile",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {
            "preferences": [
              {
                "key": "theme",
                "updatedAt": "2026-11-18T10:00:00.000Z",
                "value": "dark"
              }
            ],
            "keys": [
              {
                "key": "k1",
                "updatedAt": "2026-11-18T10:05:00.000Z",
                "deleted": true
              }
            ]
          },
          "moved": {
            "at": "2026-11-18T10:05:00.000Z",
            "note": "new host"
          }
        }
      },
      "expected": {
        "ok": true,
        "unit": {
          "format": "materia-unit",
          "version": 1,
          "kind": "profile",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {
            "preferences": [
              {
                "key": "theme",
                "updatedAt": "2026-11-18T10:00:00.000Z",
                "value": "dark"
              }
            ],
            "keys": [
              {
                "key": "k1",
                "updatedAt": "2026-11-18T10:05:00.000Z",
                "deleted": true
              }
            ]
          },
          "moved": {
            "at": "2026-11-18T10:05:00.000Z",
            "note": "new host"
          }
        }
      }
    },
    {
      "name": "moved without note",
      "input": {
        "json": {
          "format": "materia-unit",
          "version": 1,
          "kind": "library",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {},
          "moved": {
            "at": "2026-11-18T10:05:00.000Z"
          }
        }
      },
      "expected": {
        "ok": true,
        "unit": {
          "format": "materia-unit",
          "version": 1,
          "kind": "library",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {},
          "moved": {
            "at": "2026-11-18T10:05:00.000Z"
          }
        }
      }
    },
    {
      "name": "unknown top-level fields are ignored",
      "input": {
        "json": {
          "format": "materia-unit",
          "version": 1,
          "kind": "library",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z",
            "colour": "red"
          },
          "collections": {
            "specs": [
              {
                "key": "a",
                "updatedAt": "2026-11-18T10:00:00.000Z",
                "value": {
                  "n": 1
                }
              }
            ]
          },
          "extra": 1
        }
      },
      "expected": {
        "ok": true,
        "unit": {
          "format": "materia-unit",
          "version": 1,
          "kind": "library",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {
            "specs": [
              {
                "key": "a",
                "updatedAt": "2026-11-18T10:00:00.000Z",
                "value": {
                  "n": 1
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "an unknown collection is kept",
      "input": {
        "json": {
          "format": "materia-unit",
          "version": 1,
          "kind": "library",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {
            "specs": [],
            "future-things-2": [
              {
                "key": "x",
                "updatedAt": "2026-11-18T10:00:00.000Z",
                "value": 1
              }
            ]
          }
        }
      },
      "expected": {
        "ok": true,
        "unit": {
          "format": "materia-unit",
          "version": 1,
          "kind": "library",
          "unit": {
            "id": "l1",
            "name": "Mine",
            "updatedAt": "2026-11-18T10:00:00.000Z"
          },
          "collections": {
            "specs": [],
            "future-things-2": [
              {
                "key": "x",
                "updatedAt": "2026-11-18T10:00:00.000Z",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "name": "a bad record stays: the merge rejects it",
      "input": {
        "json": {
          "format": "materia-unit",
